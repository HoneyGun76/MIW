@startuml Railway Network Architecture - MIW Travel (Simplified)
!theme plain
skinparam backgroundColor white
skinparam defaultFontColor black
skinparam linetype ortho
skinparam arrow {
    Color black
    FontColor black
}

' External users and clients
node "Client Browser" as Client <<device>>
node "Admin Interface" as Admin <<device>>
node "Mobile App" as Mobile <<device>>

' External services
cloud "External Services" {
    node "Gmail SMTP\nPort 587 TLS" as SMTP <<service>>
    node "Payment Gateway\n(Future)" as Payment <<service>>
}

' Internet cloud
cloud "Internet" as Internet {
}

' Railway Platform
cloud "Railway Cloud Platform" {
    
    ' Load balancer/edge
    node "Railway Edge\nLoad Balancer\nSSL Termination" as Edge <<server>>
    
    ' Web application container
    node "Web Service\nPHP 8.1 + Apache\nContainer" as WebContainer <<server>> {
        component "MIW Application\nPort: $PORT" as App
        component "Health Check\n/health.php" as Health
    }
    
    ' Database service
    database "MySQL Service\nManaged Database" as DB <<database>>
    
    ' Persistent storage
    storage "Persistent Volume\n/app/uploads/" as Storage <<storage>>
    
    ' Monitoring
    node "Railway Monitoring\nHealth Checks\nAnalytics" as Monitor <<server>>
}

' Development environment
node "GitHub Repository" as GitHub <<repository>>
node "Railway CLI\nDeployment" as CLI <<tool>>
node "Local Development\nXAMPP" as Local <<development>>

' Network connections
Client --> Internet : HTTPS
Admin --> Internet : HTTPS 
Mobile --> Internet : HTTPS

Internet --> Edge : HTTPS\nSSL/TLS

Edge --> WebContainer : Internal HTTP\nPort $PORT

WebContainer --> DB : SQL Queries\nInternal Network\nEnvironment Variables
WebContainer --> Storage : File I/O\nPersistent Volume
WebContainer --> SMTP : SMTP TLS\nEmail Notifications
WebContainer --> Payment : HTTPS API\n(Future Integration)

Health --> Monitor : Health Status\nJSON Response
WebContainer --> Monitor : Metrics & Logs

GitHub --> CLI : Git Push\nAuto Deploy
CLI --> WebContainer : Deploy\nrailway up
Local --> GitHub : Code Push

note top of Edge
    **Railway Features:**
    • Auto-scaling
    • SSL termination
    • Load balancing
    • DDoS protection
end note

note right of DB
    **Database:**
    • Managed MySQL
    • Auto-backup
    • Connection pooling
    • UTF8MB4 charset
end note

note bottom of Storage
    **File Storage:**
    • Persistent volume
    • Survives restarts
    • 10MB max file size
    • Organized folders
end note

note left of WebContainer
    **Container:**
    • PHP 8.1 + Apache
    • Environment detection
    • Auto-restart on failure
    • Health monitoring
end note

@enduml
