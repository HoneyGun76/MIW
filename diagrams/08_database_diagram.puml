@startuml database_diagram
!theme aws-orange
title Database Entity Relationship Diagram - Sistem MIW Travel Management

entity "🧑‍🤝‍🧑 data_jamaah" as jamaah {
    --
    **🔑 Primary Key**
    --
    nik : VARCHAR(16) <<PK>>
    --
    **📝 Data Pribadi**
    --
    nama : VARCHAR(100)
    tanggal_lahir : DATE
    tempat_lahir : VARCHAR(50)
    jenis_kelamin : ENUM('L','P')
    golongan_darah : VARCHAR(3)
    alamat : TEXT
    no_hp : VARCHAR(15)
    email : VARCHAR(100)
    --
    **🎫 Data Perjalanan**
    --
    pak_id : INT <<FK>>
    no_porsi : VARCHAR(20)
    no_paspor : VARCHAR(20)
    masa_berlaku_paspor : DATE
    --
    **👥 Data Mahram/Keluarga**
    --
    hubungan_keluarga : VARCHAR(30)
    nama_mahram : VARCHAR(100)
    no_hp_mahram : VARCHAR(15)
    --
    **🏥 Data Kesehatan**
    --
    riwayat_penyakit : TEXT
    kondisi_khusus : TEXT
    nama_emergency : VARCHAR(100)
    hubungan_emergency : VARCHAR(30)
    no_hp_emergency : VARCHAR(15)
    --
    **📋 Data Administratif**
    --
    status_pembayaran : ENUM('pending','verified','cancelled')
    tanggal_daftar : TIMESTAMP
    updated_at : TIMESTAMP
    keterangan : TEXT
}

entity "📦 data_paket" as paket {
    --
    **🔑 Primary Key**
    --
    pak_id : INT AUTO_INCREMENT <<PK>>
    --
    **ℹ️ Informasi Paket**
    --
    nama_paket : VARCHAR(200)
    jenis_paket : ENUM('umroh','haji')
    tanggal_berangkat : DATE
    tanggal_pulang : DATE
    maskapai : VARCHAR(100)
    hotel_mekkah : VARCHAR(100)
    hotel_madinah : VARCHAR(100)
    --
    **💰 Harga & Kapasitas**
    --
    harga : DECIMAL(12,2)
    kapasitas : INT
    tersedia : INT
    --
    **📅 Status & Tracking**
    --
    status : ENUM('active','inactive','full','completed')
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    keterangan : TEXT
}

entity "🧾 data_invoice" as invoice {
    --
    **🔑 Primary Key**
    --
    invoice_id : INT AUTO_INCREMENT <<PK>>
    --
    **🔗 Relasi**
    --
    nik : VARCHAR(16) <<FK>>
    pak_id : INT <<FK>>
    --
    **💵 Data Pembayaran**
    --
    jumlah_bayar : DECIMAL(12,2)
    jumlah_terbilang : TEXT
    metode_pembayaran : VARCHAR(50)
    bank_tujuan : VARCHAR(100)
    --
    **📅 Tanggal & Status**
    --
    tanggal_bayar : DATE
    tanggal_invoice : TIMESTAMP
    status_verifikasi : ENUM('pending','verified','rejected')
    --
    **📎 Bukti Pembayaran**
    --
    bukti_pembayaran : VARCHAR(255)
    keterangan_verifikasi : TEXT
    verified_by : VARCHAR(100)
    verified_at : TIMESTAMP
}

entity "❌ data_pembatalan" as pembatalan {
    --
    **🔑 Primary Key**
    --
    pembatalan_id : INT AUTO_INCREMENT <<PK>>
    --
    **🔗 Relasi**
    --
    nik : VARCHAR(16) <<FK>>
    pak_id : INT <<FK>>
    --
    **📋 Data Pembatalan**
    --
    alasan_pembatalan : TEXT
    tanggal_pembatalan : TIMESTAMP
    status_refund : ENUM('pending','processing','completed','rejected')
    --
    **💰 Data Refund**
    --
    jumlah_refund : DECIMAL(12,2)
    potongan_admin : DECIMAL(12,2)
    refund_bersih : DECIMAL(12,2)
    --
    **📎 Dokumen Pendukung**
    --
    dokumen_pendukung : VARCHAR(255)
    keterangan : TEXT
    --
    **👤 Verifikasi**
    --
    processed_by : VARCHAR(100)
    processed_at : TIMESTAMP
}

entity "👨‍💼 admin_users" as admin {
    --
    **🔑 Primary Key**
    --
    id : INT AUTO_INCREMENT <<PK>>
    --
    **👤 Data Admin**
    --
    username : VARCHAR(50) <<UNIQUE>>
    password : VARCHAR(255)
    nama_lengkap : VARCHAR(100)
    email : VARCHAR(100)
    --
    **🛡️ Akses & Role**
    --
    role : ENUM('super_admin','admin','operator')
    is_active : BOOLEAN
    --
    **📅 Tracking**
    --
    last_login : TIMESTAMP
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' Primary relationships
jamaah ||--o{ invoice : "satu jamaah\nbisa punya\nbanyak invoice"
paket ||--o{ jamaah : "satu paket\nbisa diikuti\nbanyak jamaah"
paket ||--o{ invoice : "invoice berdasarkan\npaket yang dipilih"
jamaah ||--o{ pembatalan : "jamaah bisa\nmembatalkan\nperjalanan"
paket ||--o{ pembatalan : "pembatalan\nberdasarkan paket"

' Admin relationship (tidak ada FK langsung, tapi ada operasional)
admin ||..o{ invoice : "admin memverifikasi\npembayaran"
admin ||..o{ pembatalan : "admin memproses\npembatalan"
admin ||..o{ paket : "admin mengelola\npaket perjalanan"

note top of jamaah
    **Business Rules untuk Jamaah:**
    • NIK harus 16 digit unik
    • Email harus valid dan unik
    • Tanggal lahir < tanggal daftar
    • Masa berlaku paspor > tanggal berangkat
    • No HP mahram wajib untuk perempuan
    • Status default: 'pending'
end note

note top of paket
    **Business Rules untuk Paket:**
    • Tanggal berangkat > tanggal hari ini
    • Tanggal pulang > tanggal berangkat
    • Kapasitas > 0
    • Tersedia <= kapasitas
    • Harga > 0
    • Status 'full' jika tersedia = 0
end note

note bottom of invoice
    **Business Rules untuk Invoice:**
    • Satu jamaah bisa punya multiple invoice (cicilan)
    • Total bayar tidak boleh > harga paket
    • File bukti pembayaran wajib
    • Auto-generate jumlah terbilang
    • Status default: 'pending'
end note

note bottom of pembatalan
    **Business Rules untuk Pembatalan:**
    • Hanya bisa membatalkan jika status jamaah 'pending' atau 'verified'
    • Potongan admin berdasarkan kebijakan
    • Refund bersih = jumlah bayar - potongan admin
    • Dokumen pendukung opsional
    • Status default: 'pending'
end note

note right of admin
    **Security & Access:**
    • Password di-hash dengan bcrypt
    • Session-based authentication
    • Role-based access control
    • Login tracking untuk audit
    • Username case-sensitive
end note

@enduml
