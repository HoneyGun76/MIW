@startuml Cancellation_Process_Sequence

!theme plain
skinparam linetype ortho
skinparam backgroundColor white
skinparam participantBackgroundColor white
skinparam participantBorderColor black
skinparam actorBackgroundColor white
skinparam actorBorderColor black
skinparam arrowColor black

title Cancellation Process - Sequence Diagram

actor Jamaah
participant "form_pembatalan.php\n(Cancellation Form)" as CancellationForm
participant "submit_pembatalan.php\n(Cancellation Handler)" as CancellationHandler
participant "UploadHandler\n(File Upload)" as UploadHandler
participant "Database\n(data_pembatalan)" as Database
participant "email_functions.php\n(Email Service)" as EmailService
participant "admin_dashboard.php\n(Admin Dashboard)" as AdminDashboard
participant Admin

== Cancellation Request Process ==

Jamaah -> CancellationForm: Access cancellation form
activate CancellationForm
CancellationForm --> Jamaah: Display cancellation form

Jamaah -> CancellationForm: Fill NIK and personal data
Jamaah -> CancellationForm: Enter cancellation reason
Jamaah -> CancellationForm: Upload payment proof\n(kwitansi_path)
Jamaah -> CancellationForm: Upload additional proof\n(proof_path)
Jamaah -> CancellationForm: Submit cancellation request

CancellationForm -> CancellationHandler: POST cancellation data
activate CancellationHandler

== Data Validation ==

CancellationHandler -> CancellationHandler: Validate NIK format (16 digits)
CancellationHandler -> CancellationHandler: Validate email format
CancellationHandler -> CancellationHandler: Validate phone number format

CancellationHandler -> Database: Verify NIK exists\nSELECT nik FROM data_jamaah WHERE nik = ?
activate Database
Database --> CancellationHandler: Return verification result
deactivate Database

alt NIK not found
    CancellationHandler --> CancellationForm: Return error "NIK tidak terdaftar"
    CancellationForm --> Jamaah: Show error message
else NIK exists
    == Document Upload ==
    
    CancellationHandler -> UploadHandler: Upload kwitansi file
    activate UploadHandler
    UploadHandler -> UploadHandler: Validate file type (image/pdf)
    UploadHandler -> UploadHandler: Generate custom filename
    UploadHandler --> CancellationHandler: Return kwitansi path
    deactivate UploadHandler
    
    CancellationHandler -> UploadHandler: Upload proof file
    activate UploadHandler
    UploadHandler -> UploadHandler: Validate file type (image/pdf)
    UploadHandler -> UploadHandler: Generate custom filename
    UploadHandler --> CancellationHandler: Return proof path
    deactivate UploadHandler
    
    == Database Insert ==
    
    CancellationHandler -> Database: insertCancellationData()\nINSERT INTO data_pembatalan\n(nik, nama, email, alasan, file_paths)
    activate Database
    Database --> CancellationHandler: Confirm insert success
    deactivate Database
    
    == Email Notifications ==
    
    CancellationHandler -> EmailService: Calculate penalty fee
    activate EmailService
    
    EmailService -> EmailService: Build cancellation details
    EmailService -> EmailService: Send confirmation email to jamaah
    EmailService --> Jamaah: Email with cancellation details\nand penalty information
    
    EmailService -> EmailService: Build admin notification
    EmailService --> Admin: Send cancellation request\nnotification email
    deactivate EmailService
    
    CancellationHandler --> CancellationForm: Return success response
    deactivate CancellationHandler
    
    CancellationForm --> Jamaah: Show success message\nwith receipt/softcopy
end

== Admin Review Process ==

Admin -> AdminDashboard: Access admin dashboard
activate AdminDashboard
AdminDashboard --> Admin: Show pending cancellations

Admin -> AdminDashboard: Find jamaah data
AdminDashboard -> Database: Search jamaah details
activate Database
Database --> AdminDashboard: Return jamaah information
deactivate Database

Admin -> AdminDashboard: View cancellation details
Admin -> AdminDashboard: Click "Batalkan Jamaah"

AdminDashboard -> AdminDashboard: Verify payment details

alt Cancellation Approved
    AdminDashboard -> EmailService: Send approval notification
    activate EmailService
    EmailService --> Jamaah: Send cancellation approved email
    deactivate EmailService
    
    AdminDashboard -> Database: Update cancellation status to 'approved'
    activate Database
    Database --> AdminDashboard: Confirm status update
    deactivate Database
    
    AdminDashboard -> Database: Remove jamaah data\nDELETE FROM data_jamaah
    Database --> AdminDashboard: Confirm deletion
    deactivate Database
else Cancellation Rejected
    AdminDashboard -> EmailService: Send rejection notification
    activate EmailService
    EmailService --> Jamaah: Send cancellation rejected email
    deactivate EmailService
end

AdminDashboard --> Admin: Show operation result
deactivate AdminDashboard

@enduml
