@startuml Package_Management_Sequence

!theme plain
skinparam linetype ortho
skinparam backgroundColor white
skinparam participantBackgroundColor white
skinparam participantBorderColor black
skinparam actorBackgroundColor white
skinparam actorBorderColor black
skinparam arrowColor black

title Package Management - Sequence Diagram

actor Admin
participant "admin_paket.php\n(Management Page)" as AdminPage
participant "paket_functions.php\n(Package Functions)" as PackageFunctions  
participant "Database\n(data_paket)" as Database

== Package Management Process ==

Admin -> AdminPage: Access package management page
activate AdminPage

AdminPage -> PackageFunctions: getAllPackages($conn)
activate PackageFunctions

PackageFunctions -> Database: SELECT * FROM data_paket
activate Database
Database --> PackageFunctions: Return package data
deactivate Database

PackageFunctions --> AdminPage: Return all packages
deactivate PackageFunctions

AdminPage --> Admin: Display package list

== Add New Package ==

Admin -> AdminPage: Click "Add New Package"
AdminPage --> Admin: Show add package form

Admin -> AdminPage: Fill package details\n(jenis_paket, program_pilihan,\nhotel info, HCN codes)
Admin -> AdminPage: Click "Save Package"

AdminPage -> PackageFunctions: handlePackageOperations($conn)\nwith POST['add'] data
activate PackageFunctions

PackageFunctions -> PackageFunctions: Process HCN data
PackageFunctions -> PackageFunctions: Process room numbers
PackageFunctions -> PackageFunctions: Calculate available rooms

PackageFunctions -> Database: INSERT INTO data_paket\n(jenis_paket, currency, program_pilihan,\ntanggal_keberangkatan, base_prices,\nhotel details, room_numbers, hcn)
activate Database

Database --> PackageFunctions: Confirm insert success
deactivate Database

PackageFunctions --> AdminPage: Set success message\nRedirect to admin_paket.php
deactivate PackageFunctions

AdminPage --> Admin: Show success notification

@enduml
