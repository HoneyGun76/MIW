@startuml MIW_Travel_Deployment_Diagram

!theme aws-orange
title Diagram Deployment - Sistem Manajemen Perjalanan MIW Travel

' Local Development Environment
node "Local Development Environment" as local_env {
    node "XAMPP Server" as xampp {
        component "Apache HTTP Server" as apache_local {
            artifact "PHP 8.1+" as php_local
            artifact "MIW Travel Application" as app_local
        }
        
        component "MySQL Database" as mysql_local {
            database "data_miw" as db_local {
                artifact "data_paket"
                artifact "data_jamaah" 
                artifact "data_invoice"
                artifact "data_pembatalan"
            }
        }
        
        folder "Local File Storage" as storage_local {
            folder "uploads/" {
                folder "documents/"
                folder "payments/"
                folder "cancellations/"
                folder "photos/"
            }
            folder "error_logs/"
        }
    }
    
    component "VS Code" as vscode {
        artifact "PlantUML Extension"
        artifact "PHP Extension"
        artifact "Git Integration"
    }
}

' Railway Production Environment  
cloud "Railway.com Cloud Platform" as railway_cloud {
    node "Railway Application Service" as railway_app {
        component "PHP Runtime" as php_runtime {
            artifact "PHP 8.1 CLI"
            artifact "Composer Dependencies"
            artifact "MIW Travel App" as app_prod
        }
        
        component "Web Server" as web_server {
            artifact "PHP Built-in Server"
            artifact "Port 3000/Dynamic"
        }
        
        folder "Persistent Volume Storage" as persistent_storage {
            folder "/app/uploads/" {
                folder "documents/"
                folder "payments/" 
                folder "cancellations/"
                folder "photos/"
            }
            folder "/app/error_logs/"
        }
    }
    
    node "Railway MySQL Service" as railway_mysql {
        database "railway" as db_prod {
            artifact "data_paket"
            artifact "data_jamaah"
            artifact "data_invoice" 
            artifact "data_pembatalan"
            artifact "file_metadata"
            artifact "analytics_events"
        }
        
        component "MySQL 8.0" as mysql_engine
    }
    
    component "Railway Environment Variables" as env_vars {
        artifact "DB_HOST=mysql.railway.internal"
        artifact "DB_NAME=railway"
        artifact "SMTP Configuration"
        artifact "APP_ENV=production"
        artifact "MAX_FILE_SIZE=10M"
    }
}

' Docker Environment
node "Docker Desktop" as docker_env {
    component "MIW Container" as miw_container {
        artifact "takaruma7/miw:latest"
        artifact "PHP Application"
    }
    
    component "phpMyAdmin Container" as phpmyadmin {
        artifact "Database Management UI"
    }
    
    component "MySQL Container" as mysql_docker {
        database "miw_db"
    }
}

' GitHub Repository
cloud "GitHub" as github {
    component "Repository: HoneyGun76/MIW" as repo {
        artifact "Source Code"
        artifact "Configuration Files"
        artifact "Deployment Scripts"
        artifact "Documentation"
    }
}

' External Services
cloud "Gmail SMTP" as gmail {
    component "Email Service" as email_service {
        artifact "SMTP Server"
        artifact "TLS Encryption"
    }
}

cloud "CDN Services" as cdn {
    component "Bootstrap CDN"
    component "FontAwesome CDN"
    component "jQuery CDN"
}

' User Access Points
actor "Admin User" as admin
actor "Jamaah (Customer)" as customer
actor "Developer" as developer

' Connections - Local Environment
developer --> vscode : "Development"
developer --> xampp : "Testing"
php_local --> mysql_local : "Database Connection"
app_local --> storage_local : "File Upload/Download"

' Connections - Production Environment
app_prod --> railway_mysql : "Database Connection\nmysql.railway.internal:3306"
app_prod --> persistent_storage : "File Operations"
php_runtime --> env_vars : "Configuration"
web_server --> php_runtime : "Request Processing"

' Connections - External
app_prod --> gmail : "Email Notifications\nSMTP"
app_local --> gmail : "Email Testing"
app_prod --> cdn : "Static Resources"
app_local --> cdn : "Static Resources"

' Connections - Deployment
developer --> github : "Git Push"
github --> railway_app : "Auto Deploy\nCI/CD"
developer --> docker_env : "Local Testing"

' User Connections
admin --> web_server : "HTTPS Access\nAdmin Dashboard"
customer --> web_server : "HTTPS Access\nRegistration/Invoice"
admin --> xampp : "Local Testing"

' Deployment Flow
railway_app --> railway_mysql : "Internal Network"
mysql_docker --> miw_container : "Docker Network"
phpmyadmin --> mysql_docker : "Database Management"

' Notes
note right of railway_cloud
  <b>Production Environment</b>
  - Auto-scaling
  - Persistent storage
  - Environment variables
  - Health monitoring
  - SSL/TLS termination
end note

note left of local_env
  <b>Development Environment</b>
  - XAMPP stack
  - Local MySQL database
  - File-based storage
  - Debug mode enabled
end note

note bottom of docker_env
  <b>Docker Environment</b>
  - Containerized testing
  - Isolated dependencies
  - Multi-container setup
  - Volume mounting
end note

note top of github
  <b>Version Control & CI/CD</b>
  - Source code management
  - Automatic deployment
  - Branch protection
  - Issue tracking
end note

note as deployment_notes
  <b>Alur Deployment:</b>
  1. Developer code di local (XAMPP)
  2. Testing di Docker environment
  3. Push ke GitHub repository
  4. Railway auto-deploy dari GitHub
  5. Production ready dengan MySQL service
  
  <b>Environment Detection:</b>
  - config.php auto-detect Railway vs Local
  - File paths adjusted for each environment
  - Database connections switched automatically
end note

@enduml
