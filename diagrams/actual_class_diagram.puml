@startuml MIW_Travel_Actual_Classes

!theme plain
skinparam linetype ortho
skinparam backgroundColor white
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classArrowColor black
skinparam packageBorderColor black
skinparam packageBackgroundColor white
skinparam direction top to bottom layout
skinparam nodesep 30
skinparam ranksep 50


' Core System - Top Level
package "Core System" {
    class ConfigManager {
        +isProduction(): boolean
        +getCurrentEnvironment(): string
        +getUploadDirectory(): string
        +ensureUploadDirectory(): string
    }
}

' Utility Classes - Second Level  
package "Utility Classes" {
    class UploadHandler {
        -uploadBaseDir: string
        -allowedTypes: array
        -maxSize: int
        -errors: array
        --
        +__construct(uploadBaseDir: string)
        +handleUpload(file: array, targetDir: string, customName: string): array
        +getErrors(): array
        -isRailwayEnvironment(): boolean
    }
}

' Backup System - Third Level (Vertical Layout)
package "Backup System" {
    class DatabaseBackup {
        -conn: PDO
        -backupDir: string
        -retentionDays: int
        --
        +__construct(retentionDays: int)
        +createBackup(): array
        +restoreBackup(filename: string): boolean
        +listBackups(): array
        +cleanOldBackups(): void
        -ensureBackupDirectory(): void
    }
    
    DatabaseBackup -[hidden]down- FileBackup
    
    class FileBackup {
        -sourceDir: string
        -backupDir: string
        -excludePatterns: array
        --
        +__construct()
        +createBackup(): array
        +restoreBackup(backupName: string): boolean
        +listBackups(): array
        +cleanOldBackups(): void
        -ensureBackupDirectory(): void
        -shouldExclude(path: string): boolean
    }
    
    FileBackup -[hidden]down- RailwayBranchSwitcher

    class RailwayBranchSwitcher {
        -allowedBranches: array
        --
        +getCurrentBranch(): string
        +getAvailableBranches(): array
        +switchToProductionBackup(): array
        +switchToStaging(): array
        +switchToMain(): array
        +createBackupBranch(): array
        +validateBranchSwitch(targetBranch: string): boolean
        -executeBranchSwitch(targetBranch: string, sourceBranch: string): array
    }
}

' Application Logic - Fourth Level
package "Application Logic" {
    class ApplicationFiles {
        +processUmrohRegistration(): void
        +processHajiRegistration(): void
        +generateInvoice(): void
        +managePackages(): void
        +assignRooms(): void
        +verifyPayments(): void
        +processCancellation(): void
    }
}

' Database Entities - Bottom Level
package "Database Entities" {
    class DataJamaah {
        +nik: string
        +nama: string
        +pak_id: int
        +payment_status: string
        +room_assignment: string
        --
        +create(): boolean
        +update(): boolean
        +delete(): boolean
        +findByNik(): DataJamaah
    }
    
    class DataPaket {
        +pak_id: int
        +jenis_paket: string
        +program_pilihan: string
        +base_price_quad: decimal
        +base_price_triple: decimal
        +base_price_double: decimal
        --
        +create(): boolean
        +update(): boolean
        +getAllPackages(): array
        +getByType(): array
    }
    
    class DataInvoice {
        +invoice_id: string
        +nik: string
        +pak_id: int
        +payment_amount: decimal
        +payment_type: string
        --
        +create(): boolean
        +update(): boolean
        +getByNik(): DataInvoice
    }
    
    class DataPembatalan {
        +nik: string
        +alasan_pembatalan: string
        +status: string
        +refund_amount: decimal
        --
        +create(): boolean
        +update(): boolean
        +processCancellation(): boolean
    }
}

' Vertical flow relationships - Top to Bottom
ConfigManager ||--|| UploadHandler
ConfigManager ||--|| DatabaseBackup
ConfigManager ||--|| FileBackup
ConfigManager ||--|| RailwayBranchSwitcher

' Hidden connections to enforce vertical layout
ConfigManager -[hidden]down- UploadHandler
UploadHandler -[hidden]down- DatabaseBackup

UploadHandler ||--|| ApplicationFiles
DatabaseBackup ||--|| ApplicationFiles
FileBackup ||--|| ApplicationFiles
RailwayBranchSwitcher ||--|| ApplicationFiles

' More layout enforcement
DatabaseBackup -[hidden]down- ApplicationFiles

ApplicationFiles ||--|| DataJamaah
ApplicationFiles ||--|| DataPaket
ApplicationFiles ||--|| DataInvoice
ApplicationFiles ||--|| DataPembatalan

' Final layout enforcement
ApplicationFiles -[hidden]down- DataJamaah

' Entity relationships
DataJamaah ||--o{ DataInvoice
DataPaket ||--o{ DataInvoice
DataJamaah ||--o| DataPembatalan

@enduml
