@startuml railway_network_clean
!theme plain
skinparam backgroundColor white
skinparam defaultFontColor black
skinparam linetype ortho

node "Client Browser" as Client
node "Admin Interface" as Admin  
node "Mobile Client" as Mobile

cloud "Internet" as Internet

cloud "Railway Platform" as Railway {
  node "Load Balancer" as LB
  node "Web Application" as WebApp  
  database "MySQL Database" as DB
  storage "File Storage" as Storage
}

node "SMTP Server" as SMTP

Client --> Internet
Admin --> Internet
Mobile --> Internet

Internet --> LB
LB --> WebApp
WebApp --> DB
WebApp --> Storage
WebApp --> SMTP

@enduml
