@startuml deployment_diagram
!theme aws-orange
title Deployment Diagram - Sistem MIW Travel Management

!define RECTANGLE class

node "🌐 Client Layer" {
    [Web Browser] as Browser
    [Admin Browser] as AdminBrowser
    note right of Browser : Jamaah mengakses\nform pendaftaran
    note right of AdminBrowser : Admin mengelola\nsistem
}

node "☁️ Railway Cloud Platform" {
    node "🐳 Docker Container" {
        component "🐘 PHP 8.1-Apache" as PHP {
            [index.php] as Index
            [form_umroh.php] as FormUmroh
            [form_haji.php] as FormHaji
            [admin_dashboard.php] as AdminDash
            [admin_paket.php] as AdminPaket
            [admin_manifest.php] as AdminManifest
            [config.php] as Config
        }
        
        component "📁 File Storage" as FileStorage {
            folder "/app/uploads/" {
                folder "documents/" as DocFolder
                folder "payments/" as PayFolder
                folder "cancellations/" as CancelFolder
                folder "photos/" as PhotoFolder
            }
        }
        
        component "📊 Vendor Libraries" as Vendor {
            [PHPMailer] as Mailer
            [TCPDF] as PDF
            [PhpSpreadsheet] as Excel
            [DomPDF] as DomPDF
        }
    }
    
    node "🗄️ Railway MySQL" as MySQLNode {
        database "📋 data_miw" as DB {
            [data_jamaah] as TableJamaah
            [data_paket] as TablePaket
            [data_invoice] as TableInvoice
            [data_pembatalan] as TablePembatalan
            [admin_users] as TableAdmin
        }
    }
    
    node "📧 SMTP Service" as SMTPNode {
        [Gmail SMTP] as SMTP
        note right of SMTP : Email notifications\nvia environment variables
    }
}

node "🔧 Development Environment" {
    node "💻 Local XAMPP" {
        [Apache Server] as LocalApache
        [MySQL Server] as LocalMySQL
        [PHP 8.1] as LocalPHP
        folder "C:/xampp/htdocs/MIW-Railway/miw" as LocalFiles
    }
}

node "🚀 CI/CD Pipeline" {
    [GitHub Repository] as GitHub
    [Railway CLI] as RailwayCLI
    [Docker Registry] as DockerReg
    note right of GitHub : Version control\nhttps://github.com/HoneyGun76/MIW.git
}

' Client connections
Browser --> PHP : HTTPS Request
AdminBrowser --> PHP : Admin Panel Access

' Internal connections
PHP --> DB : PDO Connection\n(Railway MySQL)
PHP --> FileStorage : File Upload/Download
PHP --> Vendor : Library Usage
PHP --> SMTP : Email Sending

' Database relationships
TableJamaah --> TablePaket : pak_id foreign key
TableJamaah --> TableInvoice : nik foreign key
TableJamaah --> TablePembatalan : nik foreign key

' Development workflow
GitHub --> RailwayCLI : git push triggers\nauto deployment
RailwayCLI --> DockerReg : Build container
DockerReg --> PHP : Deploy application

' Local development
LocalFiles --> GitHub : Code development
LocalApache --> LocalMySQL : Local testing

note top of Railway
    **Railway Platform Features:**
    • Auto-scaling containers
    • Persistent file storage (/app/uploads)
    • Environment variables management
    • MySQL service integration
    • SSL/TLS termination
    • Health check monitoring
end note

note bottom of FileStorage
    **File Upload Strategy:**
    • Railway: /app/uploads/ (persistent)
    • Local: ./uploads/ (development)
    • File types: PDF, JPG, PNG
    • Max size: 10MB per file
    • Organized by subdirectories
end note

note right of DB
    **Database Schema:**
    • UTF8MB4 charset
    • InnoDB engine
    • Foreign key constraints
    • Indexes on NIK, pak_id
    • Timestamp tracking
end note

@enduml
