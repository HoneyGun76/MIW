@startuml compact_deployment_diagram

!theme plain
skinparam linetype ortho
skinparam backgroundColor white
skinparam nodeBackgroundColor white
skinparam nodeBorderColor black
skinparam componentBackgroundColor white
skinparam componentBorderColor black
skinparam artifactBackgroundColor white
skinparam artifactBorderColor black
skinparam direction top to bottom layout
skinparam nodesep 25
skinparam ranksep 45

title MIW Travel System - Deployment Diagram

' Top Level - Client
node "Client Device" <<device>> {
    artifact "Web Browser" <<browser>>
}

' Middle Level - Cloud Platform (Vertical Stack)
node "Railway Cloud Platform" <<cloud>> {
    
    node "Docker Container" <<execution environment>> {
        component "Apache+PHP 8.1" <<web server>> {
            artifact "miw-app.war" <<web app>>
        }
    }
    
    ' Application Layer
    artifact "Application Layer" <<software>> {
        component "Registration Module"
        --
        component "Admin Module" 
        --
        component "Payment Module"
        --
        component "Document Module"
    }
    
    ' Dependencies & Storage
    artifact "System Resources" <<resources>> {
        component "PHPMailer" <<library>>
        component "TCPDF" <<library>>
        component "PhpSpreadsheet" <<library>>
        --
        folder "/app/uploads/" <<file storage>>
    }
    
    ' Database Service
    node "MySQL Service" <<database server>> {
        artifact "data_miw.sql" <<database>> {
            database "data_jamaah"
            --
            database "data_paket"
            --
            database "data_pembatalan"
            --
            database "data_invoice"
        }
    }
}

' Bottom Level - External Services
node "External Infrastructure" <<external service>> {
    artifact "Gmail SMTP" <<mail service>>
    --
    artifact "Git Repository" <<version control>>
}

' Vertical communication flow
"Client Device" --> "Docker Container" : HTTPS/443
"Docker Container" --> "Application Layer" : <<runs>>
"Application Layer" --> "System Resources" : <<uses>>
"Application Layer" --> "MySQL Service" : TCP/3306
"Application Layer" --> "External Infrastructure" : SMTP/587

' Layout enforcement (hidden connections)
"Client Device" -[hidden]down- "Railway Cloud Platform"
"Docker Container" -[hidden]down- "Application Layer"
"Application Layer" -[hidden]down- "System Resources" 
"System Resources" -[hidden]down- "MySQL Service"
"Railway Cloud Platform" -[hidden]down- "External Infrastructure"

@enduml

@enduml
    **Railway Platform Features:**
    • Auto-scaling containers
    • Persistent file storage (/app/uploads)
    • Environment variables management
    • MySQL service integration
    • SSL/TLS termination
    • Health check monitoring
end note

note bottom of FileStorage
    **File Upload Strategy:**
    • Railway: /app/uploads/ (persistent)
    • Local: ./uploads/ (development)
    • File types: PDF, JPG, PNG
    • Max size: 10MB per file
    • Organized by subdirectories
end note

note right of DB
    **Database Schema:**
    • UTF8MB4 charset
    • InnoDB engine
    • Foreign key constraints
    • Indexes on NIK, pak_id
    • Timestamp tracking
end note

@enduml
